# Python virtual environment
.venv/

# llmPipeline runtime state: credentials, logs, the working database and the
# bulky intermediate JSON. The durable text snapshot of the glossary is committed
# as llmPipeline/glossary_settled.json instead - it diffs, the .db does not.
llmPipeline/out/

# Third-party TV subtitles used only as test data for the translator bake-off.
# Not thesis material, and not ours to redistribute.
Subs/

# Python cache and build artifacts
**/__pycache__/
*.pyc

# Training logs
implementation/step01/logs/

# Optional: SB3 cache (remove if you want to keep it tracked)
# implementation/step01/sb3_results_cache.json

# Optional: model checkpoints (remove if you want to keep them tracked)
# implementation/step01/models/

# Step 07 implementation: regenerable Nash CFR cache + run logs
implementation/step07/implementation/_cache/
implementation/step07/implementation/logs/

# NLHE 6-max blueprint: large regenerable artifacts + training output
implementation/nlhe/artifacts/
implementation/nlhe/runs/
# numba on-disk cache
**/__pycache__/
*.nbi
*.nbc
# cloudflared tunnel binary (large, downloadable)
implementation/nlhe/tools/

# Bundle build cache: TOC-less renders, regenerated on demand
deliverables/bundles/.parts/
